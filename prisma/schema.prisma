// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
enum PageSection {
  MAIN
  SCHOOL
}

enum PageType {
  TOP
  NONE
}

enum ContentType {
  CONTENT_PAGE
  URL
}

enum TargetType {
  SELF
  NEW
}

enum PageCategory {
  HOME
  SCHOOL
  NORMAL
}

model School {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?   @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  pages       CmsPage[]
  
  @@map("schools")
}
enum ContentBlockType {
  TITLE
  PARAGRAPH
  RICH_TEXT
  SINGLE_FILE
  GRID_TITLE
  MULTIPLE_IMAGE_GRID
}

model CmsPage {
  id              String      @id @default(uuid())
  pageName        String      @map("page_name")
  slug            String      @unique
  section         PageSection @default(MAIN)
  parentId        String?     @map("parent_id")
  subParentId     String?     @map("sub_parent_id")
  pageOrder       Int         @default(0) @map("page_order")
  pageType        PageType    @default(NONE) @map("page_type")
  contentType     ContentType @default(CONTENT_PAGE) @map("content_type")
  externalUrl     String?     @map("external_url") @db.Text
  pageTitle       String      @map("page_title")
  metaDescription String?     @map("meta_description") @db.Text
  metaKeywords    String?     @map("meta_keywords") @db.Text
  isPublished     Boolean     @default(false) @map("is_published")
  target          TargetType  @default(SELF)
  schoolId        String?     @map("school_id")
  category        PageCategory @default(NORMAL)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  parent          CmsPage?    @relation("PageHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        CmsPage[]   @relation("PageHierarchy")
  school          School?     @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  
  // Content blocks
  contentBlocks   PageContentBlock[]

  @@index([slug])
  @@index([parentId])
  @@index([section])
  @@index([schoolId])
  @@index([isPublished])
  @@index([pageOrder])
  @@index([category])
  @@map("cms_pages")
}

model PageContentBlock {
  id          String           @id @default(uuid())
  pageId      String           @map("page_id")
  blockType   ContentBlockType @map("block_type")
  title       String?          @db.Text
  content     String?          @db.LongText
  fileUrl     String?          @map("file_url") @db.Text
  fileId      String?          @map("file_id")
  sortOrder   Int              @default(0) @map("sort_order")
  isPublished Boolean          @default(true) @map("is_published")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  page        CmsPage              @relation(fields: [pageId], references: [id], onDelete: Cascade)
  gridItems   GridItem[]
  imageItems  MultipleImageItem[]
  file        File?                @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([pageId])
  @@index([blockType])
  @@index([fileId])
  @@index([sortOrder])
  @@map("page_content_blocks")
}

// For GRID_TITLE type - Simple grid with title and sections
model GridItem {
  id              String            @id @default(uuid())
  blockId         String            @map("block_id")
  imageName       String?           @map("image_name")
  imageUrl        String?           @map("image_url") @db.Text
  fileId          String?           @map("file_id")
  designationName String?           @map("designation_name")
  email           String?
  sortOrder       Int               @default(0) @map("sort_order")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  contentBlock    PageContentBlock  @relation(fields: [blockId], references: [id], onDelete: Cascade)
  file            File?             @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([blockId])
  @@index([fileId])
  @@index([sortOrder])
  @@map("grid_items")
}

// For MULTIPLE_IMAGE_GRID type - Complex grid with multiple buttons
model MultipleImageItem {
  id              String            @id @default(uuid())
  blockId         String            @map("block_id")
  imageName       String?           @map("image_name")
  imageUrl        String?           @map("image_url") @db.Text
  fileId          String?           @map("file_id")
  designationName String?           @map("designation_name")
  buttonLabel1    String?           @map("button_label_1")
  buttonLink1     String?           @map("button_link_1") @db.Text
  buttonLabel2    String?           @map("button_label_2")
  buttonLink2     String?           @map("button_link_2") @db.Text
  sortOrder       Int               @default(0) @map("sort_order")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  contentBlock    PageContentBlock  @relation(fields: [blockId], references: [id], onDelete: Cascade)
  file            File?             @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([blockId])
  @@index([fileId])
  @@index([sortOrder])
  @@map("multiple_image_items")
}

model File {
  id              String               @id @default(uuid())
  fileUploadType  String               @map("file_upload_type")
  fileIsDelete    Boolean              @default(false) @map("file_is_delete")
  fileMediaType   String               @map("file_media_type")
  fileUrl         String               @map("file_url") @db.Text
  fileThumbnail   String?              @map("file_thumbnail_url") @db.Text
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  contentBlocks   PageContentBlock[]
  gridItems       GridItem[]
  imageItems      MultipleImageItem[]

  @@index([fileUploadType])
  @@index([fileIsDelete])
  @@map("files")
}